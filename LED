const int leds[] = {2, 3, 4, 5, 6};
const int numLeds = 5;

int fingers = 0;

void setup() {
  Serial.begin(9600);
  
  for (int i = 0; i < numLeds; i++) {
    pinMode(leds[i], OUTPUT);
    digitalWrite(leds[i], LOW);
  }
}

void loop() {
  if (Serial.available() > 0) {
    String data = Serial.readStringUntil('\n');
    data.trim();
    if (data.length() > 0) {
      fingers = data.toInt();
    }
  }

  for (int i = 0; i < numLeds; i++) {
    if (i < fingers) {
      digitalWrite(leds[i], HIGH);
    } else {
      digitalWrite(leds[i], LOW);
    }
  }
}
